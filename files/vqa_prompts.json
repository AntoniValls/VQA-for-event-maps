{
  "metadata": {
    "version": "1.0",
    "description": "Comprehensive VQA Question List for Pedestrian Navigation",
    "base_context": "You are an expert at detecting pedestrian obstacles for people with low vision.",
    "date_created": "2025-11-10"
  },
  "prompt_categories": {
    "immediate_path": {
      "name": "Immediate Path Assessment",
      "description": "Assessment of the immediate forward path (approx. next 5 meters)",
      "questions": [
        {
          "id": "q_path_obstacle_ahead_present_5m",
          "text": "Is any object, person, or surface feature present on the immediate forward path (approx. next 5 meters) that requires the pedestrian to stop or significantly change course?",
          "topic": "Navigational Safety - Forward Path",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "instructions": "Focus only on the ground path directly ahead for ~5m. Identify anything that physically blocks or forces a major deviation.",
          "short_label": "Obstacle Ahead",
          "enabled": true
        },
        {
          "id": "q_path_obstacle_ahead_closest_class",
          "text": "What type is the primary obstacle (within 5m)?",
          "topic": "Object Identification",
          "type": "multiple_choice",
          "choices": [
            "Pole / Signpost / Bollard",
            "Trash Can / Street Furniture",
            "Person (Stationary)",
            "Person (Moving)",
            "Parked Vehicle / Bicycle / Scooter",
            "Construction Barrier / Debris",
            "Low/Overhanging Vegetation",
            "Unexpected Curb / Step / Drop-off",
            "Significant Hole / Grate / Uneven Surface",
            "Puddle / Standing Water",
            "Animal",
            "Other Obstacle",
            "Cannot Determine Type"
          ],
          "dependency": "q_path_obstacle_ahead_present_5m",
          "short_label": "Obstacle Type",
          "enabled": true
        },
        {
          "id": "q_spatial_primary_obstacle_clock_dir",
          "text": "What is the approximate clock-face direction of the primary path obstacle?",
          "topic": "Environment - Spatial Understanding",
          "type": "multiple_choice",
          "choices": [
            "12 o'clock (Directly Ahead)",
            "1-2 o'clock",
            "3 o'clock (Directly Right)",
            "4-5 o'clock",
            "6 o'clock (Directly Behind)",
            "7-8 o'clock",
            "9 o'clock (Directly Left)",
            "10-11 o'clock",
            "Not Applicable",
            "Cannot Determine"
          ],
          "dependency": "q_path_obstacle_ahead_present_5m",
          "short_label": "Obstacle Direction",
          "enabled": true
        },
        {
          "id": "q_path_obstacle_ahead_plan",
          "text": "What is the necessary action to navigate past this obstacle (within 5m)?",
          "topic": "Navigational Planning",
          "type": "multiple_choice",
          "choices": [
            "Deviate Left (clear path exists)",
            "Deviate Right (clear path exists)",
            "Stop and Wait",
            "Step Over Carefully",
            "Path Blocked - Requires Significant Reroute/Turn",
            "Cannot Determine Safe Action"
          ],
          "dependency": "q_path_obstacle_ahead_present_5m",
          "short_label": "Action Plan",
          "enabled": true
        },
        {
          "id": "q_path_obstacle_overhead",
          "text": "Is there a low-hanging overhead obstruction (e.g., tree branch, awning, sign) potentially impacting head clearance above the immediate path?",
          "topic": "Navigational Safety - Overhead",
          "type": "boolean",
          "choices": ["Yes", "No", "Cannot Determine"],
          "short_label": "Overhead Hazard",
          "enabled": true
        }
      ]
    },
    "environment_path": {
      "name": "Environment & Path Characteristics",
      "description": "Assessment of the walking environment and path features",
      "questions": [
        {
          "id": "q_env_path_width_assessment",
          "text": "What is the approximate clear walking path width available to the pedestrian?",
          "topic": "Environment - Accessibility / Width",
          "type": "multiple_choice",
          "choices": [
            "Narrow (~1 person wide)",
            "Adequate (~1.5-2 people wide)",
            "Wide (2+ people can easily pass)"
          ],
          "short_label": "Path Width",
          "enabled": true
        },
        {
          "id": "q_env_sidewalk_feature_present",
          "text": "Are common sidewalk features (e.g., tree pits, utility covers, grates) OR side encroachments (e.g., sign base, parked car edge, wall nearby) present within or immediately beside the walking area?",
          "topic": "Environment - Sidewalk Features",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Sidewalk Features",
          "enabled": true
        },
        {
          "id": "q_env_sidewalk_feature_type",
          "text": "What is the primary type of feature/encroachment observed?",
          "topic": "Environment - Sidewalk Features",
          "type": "multiple_choice",
          "choices": [
            "Tree Pit/Cutout",
            "Utility Cover/Access Panel",
            "Drainage Grate",
            "Cellar Door/Basement Access",
            "Signpost Base / Pole Base",
            "Parked Vehicle/Bike/Scooter Edge",
            "Building Wall/Fence Edge",
            "Other Embedded/Adjacent Feature",
            "Multiple Types Present",
            "Cannot Determine"
          ],
          "dependency": "q_env_sidewalk_feature_present",
          "short_label": "Feature Type",
          "enabled": true
        },
        {
          "id": "q_env_sidewalk_feature_hazard",
          "text": "Does this feature/encroachment appear uneven, recessed, broken, or pose a potential trip/bump hazard?",
          "topic": "Environment - Sidewalk Features / Hazard",
          "type": "boolean",
          "choices": ["Yes (Poses Hazard)", "No (Appears Safe)"],
          "dependency": "q_env_sidewalk_feature_present",
          "short_label": "Feature Hazard",
          "enabled": true
        },
        {
          "id": "q_path_surface_type",
          "text": "What is the primary surface material of the immediate walking path?",
          "topic": "Environment - Surface",
          "type": "multiple_choice",
          "choices": [
            "Concrete / Pavement",
            "Asphalt",
            "Paving Stones / Bricks",
            "Gravel / Loose",
            "Dirt / Grass / Packed Earth",
            "Tactile Paving",
            "Metal Grate",
            "Indoor",
            "Mixed / Transition",
            "Cannot Determine"
          ],
          "short_label": "Surface Type",
          "enabled": true
        },
        {
          "id": "q_path_surface_hazard",
          "text": "Is there a condition on the surface that poses a clear hazard (slip, trip, wetness)?",
          "topic": "Environment - Surface",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Surface Hazard",
          "enabled": true
        },
        {
          "id": "q_path_surface_hazard_type",
          "text": "What is the primary hazard type?",
          "topic": "Environment - Surface",
          "type": "multiple_choice",
          "choices": [
            "Wet / Slippery",
            "Uneven / Cracked / Hole / Grate",
            "Icy / Snowy",
            "Loose Debris / Thick Wet Leaves",
            "Under Construction / Dug up",
            "Other Hazard",
            "Cannot Determine"
          ],
          "dependency": "q_path_surface_hazard",
          "short_label": "Hazard Type",
          "enabled": true
        },
        {
          "id": "q_path_surface_hazard_plan",
          "text": "What action is advised due to this surface hazard?",
          "topic": "Navigational Planning",
          "type": "multiple_choice",
          "choices": [
            "Proceed with Caution",
            "Avoid Specific Area",
            "Stop if Unsafe/Unclear",
            "No Action Needed (Minor)",
            "Cannot Determine Safe Action"
          ],
          "dependency": "q_path_surface_hazard",
          "short_label": "Hazard Action",
          "enabled": true
        },
        {
          "id": "q_path_edge_definition",
          "text": "How is the edge of the path (away from buildings) defined?",
          "topic": "Environment - Path Edge",
          "type": "multiple_choice",
          "choices": [
            "Distinct Curb (Low)",
            "Distinct Curb (Medium)",
            "Distinct Curb (High)",
            "Sloped Edge / Beveled Curb",
            "Flush with Grass/Dirt",
            "Flush with Road Surface",
            "Wall / Fence",
            "Edge Not Visible"
          ],
          "short_label": "Path Edge",
          "enabled": true
        },
        {
          "id": "q_env_stairs_present",
          "text": "Are stairs (a flight of multiple steps) visible leading up or down from the current walking path?",
          "topic": "Environment - Vertical Changes",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Stairs Present",
          "enabled": true
        },
        {
          "id": "q_env_stairs_location_plan",
          "text": "Do the stairs block the forward path, offer an alternative path, or lead away from the path?",
          "topic": "Environment - Vertical Changes / Planning",
          "type": "multiple_choice",
          "choices": [
            "Block Forward Path",
            "Offer Alternative Path",
            "Lead Away from Path",
            "Cannot Determine Relevance"
          ],
          "dependency": "q_env_stairs_present",
          "short_label": "Stairs Impact",
          "enabled": true
        }
      ]
    },
    "street_crossing": {
      "name": "Street Crossing Assessment",
      "description": "Assessment of street crossing scenario and traffic control",
      "questions": [
        {
          "id": "q_crossing_approach_state",
          "text": "What is the pedestrian's current state relative to a potential street crossing location?",
          "topic": "Crossing - Scenario",
          "type": "multiple_choice",
          "choices": [
            "At Curb/Edge (Ready to Assess Crossing)",
            "Approaching Crossing Point (within 5m)",
            "Actively Crossing Street",
            "Near Crossing Area (Not Positioned to Cross)",
            "Not Near a Crossing"
          ],
          "short_label": "Crossing State",
          "enabled": true
        },
        {
          "id": "q_crossing_curb_access",
          "text": "What type of curb access is present at this crossing point?",
          "topic": "Crossing - Accessibility",
          "type": "multiple_choice",
          "choices": [
            "Curb Ramp (with tactile paving)",
            "Curb Ramp (no tactile paving)",
            "Flush / Level with street",
            "Low curb",
            "High curb",
            "Stairs",
            "Not Visible / Cannot Determine"
          ],
          "dependency": "q_crossing_approach_state",
          "short_label": "Curb Access",
          "enabled": true
        },
        {
          "id": "q_ped_signal_present_identifiable",
          "text": "Is a pedestrian signal head present and potentially identifiable for this crossing?",
          "topic": "Crossing - Traffic Control",
          "type": "boolean",
          "choices": ["Yes", "No", "Not Visible"],
          "dependency": "q_crossing_approach_state",
          "short_label": "Ped Signal",
          "enabled": true
        },
        {
          "id": "q_ped_signal_visibility_quality",
          "text": "How clearly visible is the state of the pedestrian signal?",
          "topic": "Crossing - Traffic Control / Visibility",
          "type": "multiple_choice",
          "choices": [
            "Clearly Visible",
            "Partially Obscured",
            "Blurry/Obscured/Too Far"
          ],
          "dependency": "q_ped_signal_present_identifiable",
          "short_label": "Signal Visibility",
          "enabled": true
        },
        {
          "id": "q_ped_signal_displayed_visuals",
          "text": "What is the visually displayed symbol/color/state on the pedestrian signal?",
          "topic": "Crossing - Traffic Control / Perception",
          "type": "multiple_choice",
          "choices": [
            "Clear Walk Symbol (Walking Person)",
            "Clear Don't Walk Symbol (Hand/Solid)",
            "Flashing Don't Walk / Hand Symbol",
            "Visible Countdown Timer",
            "Visible White/Lit Symbol (Shape Unclear)",
            "Visible Red/Orange Symbol (Shape Unclear)",
            "Signal Appears Off/Dark",
            "Cannot Determine Visually"
          ],
          "dependency": "q_ped_signal_present_identifiable",
          "short_label": "Signal State",
          "enabled": true
        },
        {
          "id": "q_crossing_button_visible",
          "text": "Is a pedestrian signal activation button visible near the crossing point?",
          "topic": "Crossing - Accessibility / Control",
          "type": "boolean",
          "choices": ["Yes", "No", "Cannot Determine"],
          "dependency": "q_crossing_approach_state",
          "short_label": "Button Visible",
          "enabled": true
        },
        {
          "id": "q_vehicle_traffic_present",
          "text": "Are there any vehicles currently moving towards or stopped within the lanes to be crossed?",
          "topic": "Crossing - Traffic",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_approach_state",
          "short_label": "Traffic Present",
          "enabled": true
        },
        {
          "id": "q_vehicle_traffic_nearest_state",
          "text": "What is the observed state of the NEAREST vehicle in a potentially conflicting lane?",
          "topic": "Crossing - Traffic",
          "type": "multiple_choice",
          "choices": [
            "Stopped",
            "Approaching (Actively Slowing/Yielding)",
            "Approaching (Not Yielding/Maintaining Speed)",
            "Just Passed",
            "Distant",
            "Cannot Determine State"
          ],
          "dependency": "q_vehicle_traffic_present",
          "short_label": "Vehicle State",
          "enabled": true
        },
        {
          "id": "q_crossing_plan_based_on_traffic",
          "text": "Based ONLY on the nearest vehicle's state, should the pedestrian wait?",
          "topic": "Crossing - Planning",
          "type": "boolean",
          "choices": ["Yes (Wait)", "No (Safe)"],
          "dependency": "q_vehicle_traffic_present",
          "short_label": "Wait for Traffic",
          "enabled": true
        },
        {
          "id": "q_other_peds_crossing",
          "text": "Are other pedestrians currently walking within the street crossing area?",
          "topic": "Crossing - Scenario",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_approach_state",
          "short_label": "Others Crossing",
          "enabled": true
        },
        {
          "id": "q_crossing_overall_safe_plan",
          "text": "Considering pedestrian signal AND traffic, is it safe to START crossing now?",
          "topic": "Crossing - Planning",
          "type": "multiple_choice",
          "choices": [
            "Yes (Walk Symbol + Traffic Safe)",
            "Yes (No Signal + Traffic Safe)",
            "No (Wait for Walk Signal)",
            "No (Wait for Traffic)",
            "No (Don't Walk Signal)",
            "No (Clearly Unsafe)",
            "Cannot Determine Safety"
          ],
          "dependency": "q_crossing_approach_state",
          "short_label": "Safe to Cross",
          "enabled": true
        }
      ]
    },
    "surrounding_environment": {
      "name": "Surrounding Environment & Dynamic Actors",
      "description": "Assessment of crowding, cyclists, construction, and visibility",
      "questions": [
        {
          "id": "q_env_crowding_level",
          "text": "What is the level of pedestrian crowding impacting immediate movement?",
          "topic": "Environment - Social",
          "type": "multiple_choice",
          "choices": [
            "None/Low (0-2 people)",
            "Moderate (3-5 people)",
            "Crowded (6+ people)"
          ],
          "short_label": "Crowding",
          "enabled": true
        },
        {
          "id": "q_env_crowding_plan",
          "text": "Does this level of crowding require slowing down or increased caution?",
          "topic": "Navigational Planning",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_env_crowding_level",
          "short_label": "Crowding Caution",
          "enabled": true
        },
        {
          "id": "q_bike_lane_present_location",
          "text": "Is a marked bicycle lane visible, and if so, where relative to the pedestrian path?",
          "topic": "Environment - Bike Lanes",
          "type": "multiple_choice",
          "choices": [
            "No Bike Lane Visible",
            "Yes, Adjacent Left",
            "Yes, Adjacent Right",
            "Yes, Integrated with Path",
            "Yes, Crossing Path Ahead",
            "Cannot Determine"
          ],
          "short_label": "Bike Lane",
          "enabled": true
        },
        {
          "id": "q_cyclist_present",
          "text": "Is a cyclist present within ~5-10 meters or potentially interacting with the path?",
          "topic": "Dynamic Actors - Cyclists",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Cyclist Present",
          "enabled": true
        },
        {
          "id": "q_cyclist_location_conflict",
          "text": "Where is the cyclist located and is their path likely to conflict?",
          "topic": "Dynamic Actors - Cyclists / Conflict",
          "type": "multiple_choice",
          "choices": [
            "Approaching From Front (Potential Conflict)",
            "In Adjacent Bike Lane (No Conflict)",
            "In Roadway (Potential Conflict)",
            "Passing (No Conflict)",
            "Stationary (No Conflict)",
            "Crossing Path Ahead (Yes Conflict)",
            "Unclear Path/Conflict"
          ],
          "dependency": "q_cyclist_present",
          "short_label": "Cyclist Conflict",
          "enabled": true
        },
        {
          "id": "q_cyclist_plan",
          "text": "If potential conflict identified, what action should pedestrian take?",
          "topic": "Navigational Planning",
          "type": "multiple_choice",
          "choices": [
            "Stop/Yield",
            "Adjust Speed/Position Slightly",
            "Maintain Course & Be Aware",
            "Cannot Determine Safe Action"
          ],
          "dependency": "q_cyclist_location_conflict",
          "short_label": "Cyclist Action",
          "enabled": true
        },
        {
          "id": "q_env_construction_present",
          "text": "Is active construction or pathway detour visible?",
          "topic": "Environment - Hazards",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Construction",
          "enabled": true
        },
        {
          "id": "q_env_construction_plan",
          "text": "How should the pedestrian navigate the construction area?",
          "topic": "Navigational Planning",
          "type": "multiple_choice",
          "choices": [
            "Follow marked detour signs/path",
            "Pass carefully through narrowed area",
            "Seek alternative route (path blocked)",
            "No Clear Safe Path Visible"
          ],
          "dependency": "q_env_construction_present",
          "short_label": "Construction Nav",
          "enabled": true
        },
        {
          "id": "q_path_alternative_visible",
          "text": "If the primary path is blocked, is a clear alternative safe path visible?",
          "topic": "Navigational Planning",
          "type": "boolean",
          "choices": ["Yes", "No", "Cannot Determine"],
          "short_label": "Alternative Path",
          "enabled": true
        },
        {
          "id": "q_env_visibility_lighting",
          "text": "Is visibility significantly reduced due to low light, glare, or shadows?",
          "topic": "Environment - Visibility",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Light Visibility",
          "enabled": true
        },
        {
          "id": "q_env_visibility_weather",
          "text": "Are current weather conditions reducing visibility OR making surfaces hazardous?",
          "topic": "Environment - Visibility / Hazard",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Weather Impact",
          "enabled": true
        },
        {
          "id": "q_env_outdoor_seating_encroachment",
          "text": "Is outdoor seating present and encroaching onto the main walking path?",
          "topic": "Environment - Social / Obstacle",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Seating Encroach",
          "enabled": true
        }
      ]
    },
    "points_of_interest": {
      "name": "Points of Interest",
      "description": "Assessment of nearby stores and landmarks",
      "questions": [
        {
          "id": "q_env_street_sign_visible",
          "text": "Is a street name sign visible in the current view?",
          "topic": "Environment - Navigation Aids",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Street Sign",
          "enabled": true
        },
        {
          "id": "q_env_street_sign_text",
          "text": "If a street sign is visible, is the primary text (street name) readable?",
          "topic": "Environment - Navigation Aids / OCR",
          "type": "multiple_choice",
          "choices": [
            "Yes (Transcribe Text)",
            "No (Unreadable)",
            "Not Applicable"
          ],
          "dependency": "q_env_street_sign_visible",
          "short_label": "Street Name",
          "enabled": true
        },
        {
          "id": "q_poi_store_visible_closest",
          "text": "Is a store entrance clearly visible nearby?",
          "topic": "Points of Interest",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Store Visible",
          "enabled": true
        },
        {
          "id": "q_poi_store_entrance_type",
          "text": "What type of entrance does the selected store have?",
          "topic": "Points of Interest - Accessibility",
          "type": "multiple_choice",
          "choices": [
            "Level with Automatic Door",
            "Level with Manual Door",
            "Ramp Access",
            "Single Step at Entrance",
            "Multiple Steps at Entrance",
            "Revolving Door",
            "Cannot Determine / Obscured"
          ],
          "dependency": "q_poi_store_visible_closest",
          "short_label": "Entrance Type",
          "enabled": true
        },
        {
          "id": "q_poi_store_type",
          "text": "What general type of store or service does the selected store appear to be?",
          "topic": "Points of Interest",
          "type": "multiple_choice",
          "choices": [
            "Food/Grocery/Convenience",
            "Cafe/Restaurant/Bar",
            "Pharmacy/Health",
            "Clothing/Retail (General)",
            "Bank/Office/Service",
            "Public Building",
            "Other",
            "Cannot Determine"
          ],
          "dependency": "q_poi_store_visible_closest",
          "short_label": "Store Type",
          "enabled": true
        },
        {
          "id": "q_poi_store_name",
          "text": "Is a store name or primary text visible and readable on the sign?",
          "topic": "Points of Interest / OCR",
          "type": "multiple_choice",
          "choices": [
            "Yes (Transcribe Text)",
            "No (Unreadable)",
            "No Sign Visible",
            "Not Applicable"
          ],
          "dependency": "q_poi_store_visible_closest",
          "short_label": "Store Name",
          "enabled": true
        },
        {
          "id": "q_spatial_store_entrance_clock_dir",
          "text": "What is the approximate clock-face direction of the store entrance?",
          "topic": "Environment - Spatial Understanding",
          "type": "multiple_choice",
          "choices": [
            "12 o'clock (Directly Ahead)",
            "1-2 o'clock",
            "3 o'clock (Directly Right)",
            "4-5 o'clock",
            "6 o'clock (Directly Behind)",
            "7-8 o'clock",
            "9 o'clock (Directly Left)",
            "10-11 o'clock",
            "Not Applicable",
            "Cannot Determine"
          ],
          "dependency": "q_poi_store_visible_closest",
          "short_label": "Store Direction",
          "enabled": true
        },
        {
          "id": "q_poi_store_entrance_plan_accessible",
          "text": "Does the Store Entrance appear accessible without navigating steps?",
          "topic": "Points of Interest - Planning",
          "type": "boolean",
          "choices": ["Yes (Level/Ramp)", "No (Steps detected)"],
          "dependency": "q_poi_store_visible_closest",
          "short_label": "Store Accessible",
          "enabled": true
        }
      ]
    }
  },
  "prompt_presets": {
    "safety_critical": {
      "name": "Safety Critical Only",
      "description": "Essential safety questions for real-time navigation",
      "enabled_questions": [
        "q_path_obstacle_ahead_present_5m",
        "q_path_obstacle_ahead_closest_class",
        "q_spatial_primary_obstacle_clock_dir",
        "q_path_surface_hazard",
        "q_crossing_approach_state",
        "q_ped_signal_displayed_visuals",
        "q_vehicle_traffic_present",
        "q_crossing_overall_safe_plan"
      ]
    },
    "full_assessment": {
      "name": "Full Assessment",
      "description": "All enabled questions for comprehensive analysis",
      "enabled_questions": "all"
    },
    "environment_only": {
      "name": "Environment Assessment",
      "description": "Focus on environmental characteristics",
      "enabled_questions": [
        "q_env_path_width_assessment",
        "q_path_surface_type",
        "q_path_surface_hazard",
        "q_env_crowding_level",
        "q_env_visibility_lighting",
        "q_env_visibility_weather"
      ]
    },
    "crossing_focused": {
      "name": "Street Crossing Focus",
      "description": "Detailed crossing assessment",
      "enabled_questions": [
        "q_crossing_approach_state",
        "q_crossing_curb_access",
        "q_ped_signal_present_identifiable",
        "q_ped_signal_displayed_visuals",
        "q_vehicle_traffic_present",
        "q_vehicle_traffic_nearest_state",
        "q_crossing_overall_safe_plan"
      ]
    },
    "boolean_only": {
    "name": "Boolean Questions Only",
    "description": "All questions with Yes/No answers for quick assessment",
