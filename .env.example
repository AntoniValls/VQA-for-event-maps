# Copy this file to .env (which is git-ignored) and fill in your own values.
# NEVER commit .env or paste tokens directly into the code.

# Mapillary client token: https://www.mapillary.com/dashboard/developers
# Keep the quotes: the token contains '|' characters.
MAPILLARY_TOKEN="MLY|your_client_id|your_client_token"

# Your name: recorded as the author in each sequence's info.json when you download it
VQA_AUTHOR="YourName"

# Optional: where the dataset lives (default: <repo>/data)
# VQA_DATA_DIR="/path/to/data"

# Background of the event maps (evaluation/event_map.py). Free key: https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY="your_maptiler_key"

# dataset/sync_submissions.py: one rclone remote per contributor (each has their own Drive),
# as <Author>=<remote>:<path>,... (one-time setup per remote: `rclone config`, see README)
VQA_DRIVE_REMOTES="Jorge=jorge-drive:VQA-Submissions,Loe=loe-drive:VQA-Submissions"

# Optional: rclone remote:path to back up every newly imported sequence's lean folder
# (keyframes + ground truth + metadata + results). Leave unset to skip backups.
# VQA_BACKUP_REMOTE="proton:VQA-Backups"
