{
  "metadata": {
    "version": "3.0",
    "description": "Hierarchical VQA Question System for Pedestrian Navigation",
    "base_context": "You are an expert at detecting pedestrian obstacles for people with low vision. Answer only with Yes or No.",
    "date_created": "2025-12-01",
    "date_updated": "2025-12-01"
  },
  "prompt_categories": {
    "level_1_primary": {
      "name": "Level 1: Primary Scene Assessment",
      "description": "Core questions asked for every frame - trigger conditional questions",
      "questions": [
          {
          "id": "q_pedestrian_not_on_sidewalk",
          "text": "Is the pedestrian currently outside a designated sidewalk or pedestrian path?",
          "topic": "Pedestrian - Location",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Outside Ped Path",
          "enabled": true
        },
        {
          "id": "q_crossing_nearby",
          "text": "Is there a street crossing within the next 10 meters?",
          "topic": "Crossing Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Crossing Nearby",
          "enabled": true
        },
        {
          "id": "q_stairs_visible",
          "text": "Are stairs visible on the current path?",
          "topic": "Stairs Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Stairs Present",
          "enabled": true
        },
        {
          "id": "q_construction_visible",
          "text": "Is any construction activity present on the current path?",
          "topic": "Construction Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Construction",
          "enabled": true
        },
        {
          "id": "q_obstacle_blocking",
          "text": "Is any static or movable object (not a person) blocking part of the direct path ahead?",
          "topic": "Obstacle Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Obstacle Ahead",
          "enabled": true
        },
        {
          "id": "q_pedestrians_present",
          "text": "Are multiple pedestrians visible in the walking area?",
          "topic": "Crowding Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Pedestrians Present",
          "enabled": true
        },
        {
          "id": "q_vehicle_nearby",
          "text": "Are there any vehicles within 10 meters of the pathway?",
          "topic": "Vehicle Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Vehicle Nearby",
          "enabled": true
        },
        {
          "id": "q_surface_hazardous",
          "text": "Does the path surface show abnormal conditions (water, damage, significant slope)?",
          "topic": "Surface Condition Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Surface Defects",
          "enabled": true
        }
      ]
    },
    "pedestrian_position_details": {
      "name": "Pedestrian Position & Context",
      "description": "Questions describing the pedestrian’s exact location and ground type",
      "questions": [
        {
          "id": "q_pedestrian_on_road",
          "text": "Is the pedestrian on the roadway or street surface?",
          "topic": "Pedestrian - Location",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_pedestrian_not_on_sidewalk",
          "short_label": "On Road",
          "enabled": true
        },
        {
          "id": "q_pedestrian_on_unpaved",
          "text": "Is the pedestrian walking on grass, dirt, or an unpaved surface?",
          "topic": "Pedestrian - Surface Type",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_pedestrian_not_on_sidewalk",
          "short_label": "On Unpaved",
          "enabled": true
        }
      ]
    },
    "crossing_details": {
      "name": "Crossing Questions",
      "description": "Conditional questions when crossing is detected",
      "questions": [
        {
          "id": "q_crossing_signal_present",
          "text": "Is there a pedestrian signal present at the crossing?",
          "topic": "Crossing - Signal",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_nearby",
          "short_label": "Signal Present",
          "enabled": true
        },
        {
          "id": "q_crossing_signal_red_green",
          "text": "Is the pedestrian signal showing green?",
          "topic": "Crossing - Signal State",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_signal_present",
          "short_label": "Signal Green",
          "enabled": true
        },
        {
          "id": "q_crossing_vehicles_present",
          "text": "Are vehicles currently in the crossing lanes?",
          "topic": "Crossing - Traffic",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_nearby",
          "short_label": "Vehicles in Lanes",
          "enabled": true
        },
        {
          "id": "q_crossing_vehicles_moving",
          "text": "Are the vehicles in the crossing lanes moving?",
          "topic": "Crossing - Traffic State",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_vehicles_present",
          "short_label": "Vehicles Moving",
          "enabled": true
        },
        {
          "id": "q_crossing_marked",
          "text": "Is there a crossing marked with painted lines?",
          "topic": "Crossing - Infrastructure",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_nearby",
          "short_label": "Crossing Marked",
          "enabled": true
        },
        {
          "id": "q_crossing_others_waiting",
          "text": "Are there other pedestrians on the street crossing?",
          "topic": "Crossing - Social",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_nearby",
          "short_label": "Others Crossing",
          "enabled": true
        }
      ]
    },
    "stairs_details": {
      "name": "Stairs Questions",
      "description": "Conditional questions when stairs are detected",
      "questions": [
        {
          "id": "q_stairs_heading",
          "text": "Are the stairs directly ahead on the path?",
          "topic": "Stairs - Direction",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_stairs_visible",
          "short_label": "Stairs Upward",
          "enabled": true
        },
        {
          "id": "q_stairs_handrail",
          "text": "Is there a handrail present next to the stairs?",
          "topic": "Stairs - Safety",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_stairs_visible",
          "short_label": "Handrail Present",
          "enabled": true
        },
        {
          "id": "q_stairs_only_option",
          "text": "Are the stairs the only path option visible?",
          "topic": "Stairs - Navigation",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_stairs_heading",
          "short_label": "Stairs Only Option",
          "enabled": true
        }
      ]
    },
    "construction_details": {
      "name": "Construction Questions",
      "description": "Conditional questions when construction is detected",
      "questions": [
        {
          "id": "q_construction_barriers",
          "text": "Are barriers or cones blocking the path?",
          "topic": "Construction - Blockage",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_construction_visible",
          "short_label": "Barriers Present",
          "enabled": true
        },
        {
          "id": "q_construction_equipment",
          "text": "Is construction equipment visible on or near the path?",
          "topic": "Construction - Equipment",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_construction_visible",
          "short_label": "Equipment Visible",
          "enabled": true
        },
        {
          "id": "q_construction_overhead",
          "text": "Does the expected path pass underneath any construction scaffolding or overhead work areas?",
          "topic": "Construction - Overhead Danger",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_construction_visible",
          "short_label": "Overhead Hazard",
          "enabled": true
        },
        {
          "id": "q_construction_alternative_path",
          "text": "Is an alternative path clearly marked?",
          "topic": "Construction - Navigation",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_construction_pathway_detour",
          "short_label": "Alternative Marked",
          "enabled": true
        }
      ]
    },
    "obstacle_details": {
      "name": "Obstacle Questions",
      "description": "Conditional questions when obstacle is detected",
      "questions": [
        {
          "id": "q_obstacle_upcoming_step",
          "text": "Is there an upcoming step or change in ground level on the path (e.g., curb, sidewalk transition, tilted manhole cover)?",
          "topic": "Obstacle - Type Level Change",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Step / Level Change",
          "enabled": true
        },
        {
          "id": "q_obstacle_is_vehicle",
          "text": "Is there a vehicle blocking the sidewalk?",
          "topic": "Obstacle - Type Vehicle",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Vehicle",
          "enabled": true
        },
        {
          "id": "q_obstacle_movable_objects",
          "text": "Are there movable objects on the path (furniture, planters, or loose items)?",
          "topic": "Obstacle - Type Movable",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Movable Objects",
          "enabled": true
        },
        {
          "id": "q_obstacle_fixed_infrastructure",
          "text": "Are there fixed infrastructure obstacles on the path (stairs, railings, traffic signs, streetlights, trees)?",
          "topic": "Obstacle - Type Fixed",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Fixed Infrastructure",
          "enabled": true
        },
        {
          "id": "q_obstacle_blocks_half",
          "text": "Is more than half the path width blocked?",
          "topic": "Obstacle - Severity",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Half Width Blocked",
          "enabled": true
        },
        {
          "id": "q_obstacle_space_around",
          "text": "Is there clear space to walk around the obstructions?",
          "topic": "Obstacle - Navigation",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Space Around",
          "enabled": true
        },
        {
          "id": "q_obstacle_overhead",
          "text": "Is there a low-hanging branch, awning, or sign overhead?",
          "topic": "Obstacle - Overhead",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Overhead Hazard",
          "enabled": true
        },
        {
          "id": "q_obstacle_seating",
          "text": "Is outdoor seating encroaching onto the walkway?",
          "topic": "Obstacle - Seating",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Outdoor Seating",
          "enabled": true
        }
      ]
    },
    "crowding_details": {
      "name": "Crowding Questions",
      "description": "Conditional questions when multiple pedestrians are detected",
      "questions": [
        {
          "id": "q_crowding_same_direction",
          "text": "Are the majority of pedestrians moving in the same direction?",
          "topic": "Crowding - Flow",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_pedestrians_present",
          "short_label": "Same Direction",
          "enabled": true
        },
        {
          "id": "q_crowding_slow_movement",
          "text": "Would normal walking speed need to be reduced due to pedestrians?",
          "topic": "Crowding - Impact",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_pedestrians_present",
          "short_label": "Speed Reduced",
          "enabled": true
        }
      ]
    },
    "vehicle_details": {
      "name": "Vehicle Questions",
      "description": "Conditional questions when vehicles are detected nearby",
      "questions": [
