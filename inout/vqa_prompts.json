  "question_dependencies_map": {
    "description": "Visual map of question dependencies for reference",
    "structure": {
      "level_1_triggers": {
        "q_pedestrian_not_on_sidewalk": ["q_pedestrian_on_road", "q_pedestrian_on_unpaved"],
        "q_crossing_nearby": ["q_crossing_signal_present", "q_crossing_vehicles_present", "q_crossing_marked", "q_crossing_others_waiting"],
        "q_stairs_visible": ["q_stairs_upward", "q_stairs_handrail", "q_stairs_only_option"],
        "q_construction_visible": ["q_construction_barriers", "q_construction_equipment", "q_construction_overhead", "q_construction_pathway_detour"],
        "q_obstacle_blocking": ["q_obstacle_upcoming_step", "q_obstacle_is_vehicle", "q_obstacle_movable_objects", "q_obstacle_fixed_infrastructure", "q_obstacle_blocks_half", "q_obstacle_space_around", "q_obstacle_overhead", "q_obstacle_seating"],
        "q_pedestrians_present": ["q_crowding_more_than_five", "q_crowding_same_direction", "q_crowding_path_reduced"],
        "q_vehicle_nearby": ["q_vehicle_is_bicycle", "q_vehicle_is_car_truck_bus", "q_vehicle_is_motorcycle"],
        "q_surface_hazardous": ["q_surface_water_ice", "q_surface_sloped", "q_surface_cracks_holes", "q_surface_overhead_hazard"]
