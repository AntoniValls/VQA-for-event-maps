          "choices": ["Yes", "No"],
          "dependency": "q_vehicle_nearby",
          "short_label": "Bicycle",
          "enabled": true
        },
        {
          "id": "q_vehicle_is_car_truck_bus",
          "text": "Is there a car, truck or bus within 10 meters of the path?",
          "topic": "Vehicle - Type Motor",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_vehicle_nearby",
          "short_label": "Car/Truck/Bus",
          "enabled": true
        },
        {
          "id": "q_vehicle_is_motorcycle",
          "text": "Is there a motorcycle within 10 meters of the path?",
          "topic": "Vehicle - Type Two-Wheeler",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_vehicle_nearby",
          "short_label": "Motorcycle",
          "enabled": true
        },
        {
          "id": "q_bicycle_moving",
          "text": "Is the bicycle moving?",
          "topic": "Vehicle - Bicycle Movement",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_vehicle_is_bicycle",
          "short_label": "Bicycle Moving",
          "enabled": true
        },
        {
          "id": "q_bicycle_bike_lane",
          "text": "Is the bicycle on a dedicated bike lane?",
          "topic": "Vehicle - Bicycle Location",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_vehicle_is_bicycle",
          "short_label": "On Bike Lane",
          "enabled": true
        },
        {
          "id": "q_motor_vehicle_moving",
          "text": "Is there a car, truck or bus moving?",
          "topic": "Vehicle - Motor Movement",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_vehicle_is_car_truck_bus",
          "short_label": "Vehicle Moving",
          "enabled": true
        },
        {
          "id": "q_motor_vehicle_blocking",
          "text": "Is the car, truck or bus on the sidewalk?",
          "topic": "Vehicle - Motor Blockage",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_vehicle_is_car_truck_bus",
          "short_label": "Blocking Path",
          "enabled": true
        },
        {
          "id": "q_motorcycle_sidewalk",
          "text": "Is the motorcycle on the sidewalk?",
          "topic": "Vehicle - Two-Wheeler Location",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_vehicle_is_motorcycle",
          "short_label": "On Sidewalk",
          "enabled": true
        },
        {
          "id": "q_motorcycle_moving",
          "text": "Is the motorcycle moving?",
          "topic": "Vehicle - Two-Wheeler Movement",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_vehicle_is_motorcycle",
          "short_label": "Motorcycle Moving",
          "enabled": true
        }
      ]
    },
    "surface_details": {
      "name": "Surface Questions",
      "description": "Conditional questions when surface hazard is detected",
      "questions": [
        {
          "id": "q_surface_water_ice",
