        "q_construction_pathway_detour": ["q_construction_alternative_path"],
        "q_vehicle_is_bicycle": ["q_bicycle_moving", "q_bicycle_bike_lane"],
        "q_vehicle_is_car_truck_bus": ["q_motor_vehicle_moving", "q_motor_vehicle_blocking"],
        "q_vehicle_is_motorcycle": ["q_motorcycle_sidewalk", "q_motorcycle_motorized", "q_motorcycle_moving"]
