          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_surface_hazardous",
          "short_label": "Water/Ice",
          "enabled": true
        },
        {
          "id": "q_surface_sloped",
          "text": "Is the surface noticeably sloped or tilted?",
          "topic": "Surface - Slope",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_surface_hazardous",
          "short_label": "Sloped",
          "enabled": true
        },
        {
          "id": "q_surface_cracks_holes",
          "text": "Are there cracks or holes in the pavement?",
          "topic": "Surface - Damage",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_surface_hazardous",
          "short_label": "Cracks/Holes",
          "enabled": true
        },
        {
          "id": "q_surface_cracks_holes",
          "text": "Is the pavement visibly damaged (large cracks, holes, or broken sections)?",
          "topic": "Surface - Damage",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_surface_hazardous",
          "short_label": "Cracks/Holes",
          "enabled": true
        }
      ]
    }
  },
