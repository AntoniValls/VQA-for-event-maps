{
  "metadata": {
    "version": "2.0",
    "description": "Hierarchical VQA Question System for Pedestrian Navigation",
    "base_context": "You are an expert at detecting pedestrian obstacles for people with low vision. Answer only with Yes or No.",
    "date_created": "2025-11-24"
  },
  "prompt_categories": {
    "level_1_primary": {
      "name": "Level 1: Primary Scene Assessment",
      "description": "Core questions asked for every frame - trigger conditional questions",
      "questions": [
        {
          "id": "q_crossing_nearby",
          "text": "Is there a street crossing within the next 10 meters?",
          "topic": "Crossing Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Crossing Nearby",
          "enabled": true
        },
        {
          "id": "q_stairs_visible",
          "text": "Are stairs visible on the current path?",
          "topic": "Stairs Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Stairs Present",
          "enabled": true
        },
        {
          "id": "q_construction_visible",
          "text": "Is construction or a pathway detour visible?",
          "topic": "Construction Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Construction",
          "enabled": true
        },
        {
          "id": "q_obstacle_blocking",
          "text": "Is any obstacle blocking the direct path ahead?",
          "topic": "Obstacle Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Obstacle Ahead",
          "enabled": true
        },
        {
          "id": "q_pedestrians_present",
          "text": "Are multiple pedestrians visible in the walking area?",
          "topic": "Crowding Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Pedestrians Present",
          "enabled": true
        },
        {
          "id": "q_vehicle_nearby",
          "text": "Is any vehicle within 10 meters of the path?",
          "topic": "Vehicle Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Vehicle Nearby",
          "enabled": true
        },
        {
          "id": "q_surface_hazardous",
          "text": "Is the path surface hazardous (wet, broken, or uneven)?",
          "topic": "Surface Hazard Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Surface Hazard",
          "enabled": true
        },
        {
          "id": "q_visibility_reduced",
          "text": "Is visibility reduced (darkness, glare, or shadows)?",
          "topic": "Visibility Detection",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "short_label": "Reduced Visibility",
          "enabled": true
        }
      ]
    },
    "crossing_details": {
      "name": "Crossing Questions",
      "description": "Conditional questions when crossing is detected",
      "questions": [
        {
          "id": "q_crossing_signal_present",
          "text": "Is a pedestrian signal present at this crossing?",
          "topic": "Crossing - Signal",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_nearby",
          "short_label": "Signal Present",
          "enabled": true
        },
        {
          "id": "q_crossing_signal_red_green",
          "text": "Is the pedestrian signal showing red or green?",
          "topic": "Crossing - Signal State",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_signal_present",
          "short_label": "Signal Red/Green",
          "enabled": true
        },
        {
          "id": "q_crossing_vehicles_present",
          "text": "Are vehicles currently in the crossing lanes?",
          "topic": "Crossing - Traffic",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_nearby",
          "short_label": "Vehicles in Lanes",
          "enabled": true
        },
        {
          "id": "q_crossing_vehicles_moving",
          "text": "Are the vehicles moving or stopped?",
          "topic": "Crossing - Traffic State",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_vehicles_present",
          "short_label": "Vehicles Moving",
          "enabled": true
        },
        {
          "id": "q_crossing_marked",
          "text": "Is the crossing marked with painted lines?",
          "topic": "Crossing - Infrastructure",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_nearby",
          "short_label": "Crossing Marked",
          "enabled": true
        },
        {
          "id": "q_crossing_others_waiting",
          "text": "Are other pedestrians waiting or crossing?",
          "topic": "Crossing - Social",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_crossing_nearby",
          "short_label": "Others Crossing",
          "enabled": true
        }
      ]
    },
    "stairs_details": {
      "name": "Stairs Questions",
      "description": "Conditional questions when stairs are detected",
      "questions": [
        {
          "id": "q_stairs_upward",
          "text": "Do the stairs lead upward or downward?",
          "topic": "Stairs - Direction",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_stairs_visible",
          "short_label": "Stairs Upward",
          "enabled": true
        },
        {
          "id": "q_stairs_handrail",
          "text": "Is there a handrail present?",
          "topic": "Stairs - Safety",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_stairs_visible",
          "short_label": "Handrail Present",
          "enabled": true
        },
        {
          "id": "q_stairs_only_option",
          "text": "Are the stairs the only path option visible?",
          "topic": "Stairs - Navigation",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_stairs_visible",
          "short_label": "Stairs Only Option",
          "enabled": true
        }
      ]
    },
    "construction_details": {
      "name": "Construction Questions",
      "description": "Conditional questions when construction is detected",
      "questions": [
        {
          "id": "q_construction_barriers",
          "text": "Are barriers or cones blocking the path?",
          "topic": "Construction - Blockage",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_construction_visible",
          "short_label": "Barriers Present",
          "enabled": true
        },
        {
          "id": "q_construction_equipment",
          "text": "Is construction equipment visible?",
          "topic": "Construction - Equipment",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_construction_visible",
          "short_label": "Equipment Visible",
          "enabled": true
        },
        {
          "id": "q_construction_alternative_marked",
          "text": "Is an alternative path clearly marked?",
          "topic": "Construction - Navigation",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_construction_visible",
          "short_label": "Alternative Marked",
          "enabled": true
        }
      ]
    },
    "obstacle_details": {
      "name": "Obstacle Questions",
      "description": "Conditional questions when obstacle is detected",
      "questions": [
        {
          "id": "q_obstacle_is_person",
          "text": "Is the obstacle a person?",
          "topic": "Obstacle - Type",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Obstacle Person",
          "enabled": true
        },
        {
          "id": "q_obstacle_is_object",
          "text": "Is the obstacle an object?",
          "topic": "Obstacle - Type",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Obstacle Object",
          "enabled": true
        },
        {
          "id": "q_obstacle_is_vehicle",
          "text": "Is the obstacle a vehicle?",
          "topic": "Obstacle - Type",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Obstacle Vehicle",
          "enabled": true
        },
        {
          "id": "q_obstacle_blocks_half",
          "text": "Does the obstacle block more than half the path width?",
          "topic": "Obstacle - Severity",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Blocks Half Path",
          "enabled": true
        },
        {
          "id": "q_obstacle_space_around",
          "text": "Is there clear space to walk around the obstacle?",
          "topic": "Obstacle - Navigation",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Space Around",
          "enabled": true
        },
        {
          "id": "q_obstacle_seating",
          "text": "Is outdoor seating encroaching onto the walkway?",
          "topic": "Obstacle - Seating",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Seating Encroach",
          "enabled": true
        },
        {
          "id": "q_obstacle_overhead",
          "text": "Is there a low-hanging branch, awning, or sign overhead?",
          "topic": "Obstacle - Overhead",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_obstacle_blocking",
          "short_label": "Overhead Hazard",
          "enabled": true
        }
      ]
    },
    "crowding_details": {
      "name": "Crowding Questions",
      "description": "Conditional questions when pedestrians are detected",
      "questions": [
        {
          "id": "q_crowding_more_than_five",
          "text": "Are more than 5 pedestrians visible ahead?",
          "topic": "Crowding - Density",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_pedestrians_present",
          "short_label": "5+ Pedestrians",
          "enabled": true
        },
        {
          "id": "q_crowding_same_direction",
          "text": "Are pedestrians moving in the same direction?",
          "topic": "Crowding - Flow",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_pedestrians_present",
          "short_label": "Same Direction",
          "enabled": true
        },
        {
          "id": "q_crowding_path_reduced",
          "text": "Is the path width reduced due to crowding?",
          "topic": "Crowding - Impact",
          "type": "boolean",
          "choices": ["Yes", "No"],
          "dependency": "q_pedestrians_present",
          "short_label": "Width Reduced",
          "enabled": true
        }
      ]
    },
    "vehicle_details": {
      "name": "Vehicle Questions",
      "description": "Conditional questions when vehicle is detected",
      "questions": [
